{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loker-farmasi",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "JOB_SNAPSHOTS" }
  ]
}
