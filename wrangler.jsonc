{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loker-farmasi",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "triggers": { "crons": ["*/5 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "JOB_COLLECTOR", "class_name": "JobCollector" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JobCollector"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "JOB_SNAPSHOTS" }
  ]
}
